rules_version = '2';

// All Firestore access in this app is server-side via the Admin SDK, which
// bypasses these rules. The browser never reads or writes Firestore directly,
// so we deny every client request.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
