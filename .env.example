# ---------------------------------------------------------------------------
# Firebase — public web config (safe to expose; used by the admin login UI)
# Get these from Firebase console → Project settings → Your apps → Web app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin (server) credentials
#  - On Firebase App Hosting these are provided automatically (ADC) — leave blank.
#  - For local dev + the seed script, paste the full service account JSON on one
#    line (Firebase console → Project settings → Service accounts → Generate key).
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=
# Optional explicit bucket override (defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET)
FIREBASE_STORAGE_BUCKET=

# ---------------------------------------------------------------------------
# Google Places API (New) for live reviews (optional)
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Public site URL for SEO metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
